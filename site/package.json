{
  "name": "enhq-site",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "The Execs NOW HQ marketing site: static Astro pages and a small Node server.",
  "engines": { "node": ">=22.23.4" },
  "scripts": {
    "changelog": "node scripts/changelog.mjs",
    "dev": "astro dev --port 5300",
    "build": "node scripts/changelog.mjs && astro build",
    "preview": "node server.mjs",
    "start": "node server.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "astro": "7.4.7",
    "tailwindcss": "4.3.5",
    "@tailwindcss/vite": "4.3.5"
  }
}
