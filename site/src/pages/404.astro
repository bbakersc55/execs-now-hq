---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" description="That page isn't here. Start from the Execs NOW HQ home page, or sign in to the app." noindex>
  <section class="wrap max-w-3xl pt-20 pb-10">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-4xl font-extrabold">That page isn't here.</h1>
    <p class="mt-4 text-lg leading-relaxed text-[#33394a]">It may have moved. Start from the home page, or sign in to the app.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn-ghost">Home page</a>
      <a href="https://app.getexecutivesnow.com" class="btn-ghost">Sign in</a>
    </div>
  </section>
</Base>
