---
interface Props { n: string; title: string; id?: string; line?: string }
const { n, title, line } = Astro.props;
---
<div class="max-w-3xl">
  <p class="eyebrow"><span class="mr-2 inline-block border-b-2 border-orange pb-0.5 tabular-nums">{n}</span></p>
  <h2 class="mt-3 text-3xl font-extrabold leading-tight sm:text-4xl">{title}</h2>
  {line && <p class="mt-4 font-display text-lg font-semibold text-orange-ink">{line}</p>}
  <slot />
</div>
