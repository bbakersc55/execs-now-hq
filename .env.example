# ---------- Core ----------
DJANGO_SECRET_KEY=change-me-generate-a-new-one
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Railway: app.getexecutivesnow.com,healthcheck.railway.app (the second is the
# Host header Railway's health check sends).
# Off localhost, DJANGO_SECRET_KEY left at its default and DJANGO_DEBUG=True
# are both refused at startup.
PUBLIC_BASE_URL=http://localhost:8100
# local | demo | production. Defaults from PUBLIC_BASE_URL (localhost -> local,
# anything else -> production), so the DEMO must set it: APP_ENVIRONMENT=demo
# turns off all outbound email, Drive and mailbox reading, Google connects and
# the worker, and shows staff a Demo banner (config/environment.py). The demo
# also needs its own GCS_BUCKET_MEDIA; the production bucket is refused.
APP_ENVIRONMENT=local
# Where a successful sign-in lands. Dev: the Vite origin. Prod: "/".
APP_ROOT_URL=http://localhost:5200/
# Extra origins trusted for CSRF, comma-separated. PUBLIC_BASE_URL is always
# trusted off localhost; add a staging host here if it serves another origin.
CSRF_TRUSTED_ORIGINS=
# ^ THE most consequential variable here. While this is localhost, outbound mail
#   goes to Mailpit unless the recipient is in DEV_REAL_SEND_ALLOWLIST.

# ---------- Database ----------
# Empty host = connect over the local Unix socket using peer auth, which needs
# no password. A TCP form (postgres://user@localhost:5432/db) requires a
# password to be configured in Postgres first.
DATABASE_URL=postgres:///execsnowhq_local
# ^ The laptop's database since B7 (2026-10-02): a scrubbed copy of production,
#   rebuilt by scripts/refresh_dev_from_prod.sh. execsnowhq_dev is the old
#   pre-cutover database, kept only as the fallback; never point the app at it.

# ---------- Encryption ----------
# Fernet key protecting tenant_secret.ciphertext (Anthropic key, OAuth tokens).
# Generate: .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER commit. If lost, every stored secret is unrecoverable.
FIELD_ENCRYPTION_KEY=

# ---------- Background jobs ----------
Q_CLUSTER_WORKERS=4
# >=4 so a long transcription cannot sit in front of a digest (assumption A2).

# ---------- Email ----------
EMAIL_HOST=localhost
EMAIL_PORT=1025
# Beta: all app mail goes through the tenant's connected Gmail with From set to
# their send-as alias. Postmark is a V1 per-tenant option.
APP_MAIL_TRANSPORT=gmail

# --- Postmark: OPTIONAL in Beta, only used when APP_MAIL_TRANSPORT=postmark ---
POSTMARK_SERVER_TOKEN=
POSTMARK_TRANSACTIONAL_STREAM=outbound
POSTMARK_BROADCAST_STREAM=broadcast
# Module 6: the inbound webhook verifies before processing (FR-6.11).
POSTMARK_INBOUND_WEBHOOK_SECRET=
DEFAULT_FROM_ADDRESS=info@getexecutivesnow.com
INBOUND_DOMAIN=inbound.getexecutivesnow.com

# Exact addresses that receive REAL mail from this laptop build (assumption H6).
# Comma-separated. EXACT ADDRESSES ONLY — a domain wildcard is rejected at startup.
DEV_REAL_SEND_ALLOWLIST=bryan.baker@getexecutivesnow.com

# ---------- Anthropic ----------
# Dev fallback only, used when the tenant has no stored key. Refused when
# PUBLIC_BASE_URL is not localhost (assumption E1.6).
ANTHROPIC_API_KEY=
# The model string the app calls. Changeable without a code change.
ANTHROPIC_MODEL=claude-opus-5

# ---------- Google ----------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# P2 D1: the second OAuth client (its own GCP project, consent screen External)
# for practices outside the Executives Now Workspace. Redirect URIs on it:
# <PUBLIC_BASE_URL>/accounts/google/external/callback and /accounts/gmail/callback.
# docs/google_verification.md. Empty: no outside practice can sign in yet.
GOOGLE_OAUTH_EXTERNAL_CLIENT_ID=
GOOGLE_OAUTH_EXTERNAL_CLIENT_SECRET=
# P2: practice owners accept the beta agreement before using the app. Leave on.
BETA_AGREEMENT_REQUIRED=True
GOOGLE_CLOUD_PROJECT=execs-now-hq
# The app's OWN Google API calls (Speech-to-Text, GCS media, Drive where it is
# not acting on a tenant's OAuth token) use a dedicated service-account key.
# Path is OUTSIDE the repo and never committed. The backup script does NOT use
# this — it uses the gcloud CLI. The app never uses gcloud ADC (assumption A7).
GOOGLE_APPLICATION_CREDENTIALS=~/.config/execs-now-hq/sa-app.json
# Railway (Phase 7): the same key's CONTENTS, as a secret variable, instead of
# a path. Preferred over GOOGLE_APPLICATION_CREDENTIALS when set. Leave empty
# on the laptop.
GOOGLE_SA_APP_JSON=
GOOGLE_STT_LANGUAGE=en-US
# Where stored_file CONTENT lives. gcs = gs://$GCS_BUCKET_MEDIA/<object_key>,
# read and written with the key above. `local` (MEDIA_ROOT/<bucket>/<key>) is
# the LAPTOP's setting since B7, and the test suite's; refused off localhost.
# The laptop must not use gcs: execsnowhq_local's rows point at production's
# bucket, and the app key can delete there. Railway sets gcs.
STORAGE_BACKEND=local
GCS_BUCKET_MEDIA=execs-now-hq-media
# Only read when STORAGE_BACKEND=local. Absolute path; default <repo>/media.
MEDIA_ROOT=

# ---------- Backups ----------
BACKUP_BUCKET=gs://execs-now-hq-db-backups
BACKUP_RETENTION_DAYS=30
# Railway backup cron service ONLY (scripts/backup_db_railway.sh): the
# backup-writer service account's key contents (runbook A4a). Not on web or
# qcluster, and not on the laptop, whose backup uses gcloud.
GOOGLE_SA_BACKUP_JSON=

# ---------- Errors ----------
SENTRY_DSN=
# Enabled only when PUBLIC_BASE_URL is not localhost (assumption A5).

# Reminder emails to the practice's own people when digests are ready to
# approve, about to miss their send time, or were not sent. On by default;
# set to false to stop them without a release.
# DIGEST_REMINDERS_ENABLED=true

# ---------- NMI sandbox (P4 Phase 0 only) ----------
# Test keys from NMI's sandbox, read only by scripts/nmi_sandbox_check.py on
# the laptop. Never a live key: the live ones are NMI_PLATFORM_* in Railway,
# and do not exist until P4's subscriptions are built.
NMI_SANDBOX_SECURITY_KEY=
NMI_SANDBOX_TOKENIZATION_KEY=
NMI_SANDBOX_WEBHOOK_KEY=
